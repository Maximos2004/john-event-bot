[Unit]
Description=John Event Discord Bot - NL Game Dev Radar
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/john-event-bot
ExecStart=/home/ubuntu/john-event-bot/venv/bin/python -u bot.py
Restart=always
RestartSec=10
EnvironmentFile=/home/ubuntu/john-event-bot/.env
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
